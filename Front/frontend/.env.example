# Copy to .env.local to override. Read by Vite at dev/build time.

# Backend the Vite dev server proxies /api and /health to (start backend/ with `npm run dev`).
VITE_BACKEND_URL=http://localhost:3001

# Presenter pacing: pause between scenario steps, in ms (integer 0–1000; anything else → 400).
# The demo launcher (scripts/demo.mjs) sets 900 unless you pass --pace <ms>.
VITE_SCENARIO_STEP_DELAY_MS=400
