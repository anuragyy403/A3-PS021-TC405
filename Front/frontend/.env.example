# Copy to .env.local to override. Both variables are read by Vite at dev/build time.

# Which engine drives the dashboard:
#   backend (default) — the backend API is the source of truth (start backend/ with `npm run dev`)
#   sim               — the original in-browser simulation, not connected to the backend
VITE_ENGINE=backend

# Backend the Vite dev server proxies /api and /health to.
VITE_BACKEND_URL=http://localhost:3001
